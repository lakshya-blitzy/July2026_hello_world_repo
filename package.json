{
  "name": "july2026_hello_world_repo",
  "version": "1.0.0",
  "description": "Minimal Node.js HTTP server with a Jest test suite",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:ci": "jest --ci --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration",
    "test:e2e": "jest test/e2e",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand"
  },
  "dependencies": {},
  "devDependencies": {
    "jest": "30.4.2",
    "supertest": "7.2.2"
  },
  "overrides": {
    "glob": "13.0.6",
    "test-exclude": "8.0.0"
  }
}
